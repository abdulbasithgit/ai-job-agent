{
  "name": "ai-job-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI job agent: finds, evaluates and emails the best matching software jobs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
